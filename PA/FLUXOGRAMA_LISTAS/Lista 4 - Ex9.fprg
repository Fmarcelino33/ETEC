<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Lista 4 - Ex9"/>
        <attribute name="authors" value="francisco"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value=""/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2, num3, num4, soma1, sub1, resultado" type="Real" array="False" size=""/>
            <input variable="num1"/>
            <input variable="num2"/>
            <input variable="num3"/>
            <input variable="num4"/>
            <assign variable="soma1" expression="num1 + num2"/>
            <assign variable="sub1" expression="num3 - num4"/>
            <assign variable="resultado" expression="soma1 + sub1"/>
            <if expression="resultado &gt; 10">
                            <then>
                                <output expression="&quot;Resultado maior que dez&quot;" newline="True"/>
                            </then>
                            <else>
                                <output expression="&quot;Resultado menor ou igual a dez&quot;" newline="True"/>
                            </else>
                        </if>
        </body>
    </function>
</flowgorithm>
