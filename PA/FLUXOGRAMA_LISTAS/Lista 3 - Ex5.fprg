<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Lista 3 - Ex5"/>
        <attribute name="authors" value="francisco"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value=""/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2" type="Real" array="False" size=""/>
            <input variable="num1"/>
            <input variable="num2"/>
            <if expression="(num1 + num2) &lt; 20">
                            <then>
                                <output expression="num1 * 10" newline="True"/>
                                <output expression="num2 * 10" newline="True"/>
                            </then>
                            <else/>
                        </if>
        </body>
    </function>
</flowgorithm>
