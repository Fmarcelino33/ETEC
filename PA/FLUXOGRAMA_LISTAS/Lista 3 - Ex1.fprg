<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Lista 3 - Ex1"/>
        <attribute name="authors" value="francisco"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value=""/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Real" array="False" size=""/>
            <input variable="numero"/>
            <if expression="numero &lt; 5">
                            <then>
                                <output expression="&quot;Numero menor que 5&quot;" newline="True"/>
                            </then>
                            <else/>
                        </if>
        </body>
    </function>
</flowgorithm>
