<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Lista 1 - Ex10"/>
        <attribute name="authors" value="francisco"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value=""/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, metade, variavelA, variavelB" type="Real" array="False" size=""/>
            <input variable="numero"/>
            <assign variable="metade" expression="numero / 2"/>
            <assign variable="variavelA" expression="metade"/>
            <assign variable="variavelB" expression="metade"/>
            <assign variable="variavelA" expression="variavelA + 3"/>
            <assign variable="variavelB" expression="variavelB + 5"/>
            <output expression="variavelA" newline="True"/>
            <output expression="variavelB" newline="True"/>
        </body>
    </function>
</flowgorithm>
