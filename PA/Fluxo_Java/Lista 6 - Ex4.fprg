<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Lista 6 - Ex4"/>
        <attribute name="authors" value="francisco"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value=""/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, j" type="Real" array="False" size=""/>
            <input variable="numero"/>
            <assign variable="j" expression="1"/>
            <while expression="j &lt;= 10">
                            <output expression="numero * j" newline="True"/>
                            <assign variable="j" expression="j + 1"/>
                        </while>
        </body>
    </function>
</flowgorithm>
