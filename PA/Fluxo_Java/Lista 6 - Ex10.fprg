<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Lista 6 - Ex10"/>
        <attribute name="authors" value="francisco"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value=""/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Real" array="False" size=""/>
            <input variable="numero"/>
            <while expression="numero &lt; 5">
                            <input variable="numero"/>
                        </while>
            <while expression="numero &gt; 10">
                            <input variable="numero"/>
                        </while>
            <output expression="numero" newline="True"/>
        </body>
    </function>
</flowgorithm>
